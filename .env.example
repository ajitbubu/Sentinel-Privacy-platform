# ==================== Shared ====================
APP_ENV=development
LOG_LEVEL=INFO

# ==================== Database ====================
DATABASE_URL=postgresql://admin:password@localhost:5432/consent_db
MONGO_URL=mongodb://admin:password@localhost:27017/consent_db
REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_HOSTS=http://localhost:9200

# ==================== Security ====================
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=change-me-32-byte-key-for-aes256

# ==================== PMP Portal ====================
PMP_API_PORT=8001
PMP_FRONTEND_URL=http://localhost:3001

# ==================== IDP Console ====================
IDP_API_PORT=8002
IDP_FRONTEND_URL=http://localhost:3002

# ==================== External API ====================
EXTERNAL_API_PORT=8003

# ==================== Integrations ====================
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
HUBSPOT_API_KEY=
OUTREACH_CLIENT_ID=
OUTREACH_CLIENT_SECRET=
HIGHSPOT_API_KEY=

# ==================== Notifications ====================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Magic-link auth (PMP)
MAGIC_LINK_EXPIRE_MINUTES=15
PMP_FRONTEND_URL=http://localhost:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=privacy@yourcompany.com

# IDP admin auth
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER=Sentinel Privacy Platform

# ==================== CMP (cookie banner / consent collector) ====================
# Signing key for consent receipts (ES256, P-256 PEM). Leave BLANK in dev - the
# service generates an ephemeral key and warns loudly. In production it is
# REQUIRED: the app raises at startup without it, because receipts signed by a
# key that dies with the process cannot be verified later, which defeats their
# entire purpose as evidence.
#   openssl ecparam -name prime256v1 -genkey -noout -out receipt.pem
RECEIPT_PRIVATE_KEY=

# Number of proxies in front of the API that rewrite X-Forwarded-For.
#
# READ THIS BEFORE DEPLOYING. Getting it wrong breaks rate limiting in one of
# two ways, and neither is obvious from the outside:
#
#   Too LOW (e.g. left at 0 behind a load balancer) - every visitor appears to
#   come from the balancer's own IP, so they all share ONE bucket. The limit
#   below stops being per-visitor and starts throttling your real traffic.
#
#   Too HIGH - the count reaches back into entries the caller wrote, so anyone
#   can spoof their own address and rotate past the limit freely.
#
#   0 = directly exposed, header ignored entirely (safe default)
#   1 = behind a single ALB / nginx
#   2 = behind CloudFront -> ALB
COLLECTOR_TRUSTED_PROXY_HOPS=0

# Per-visitor collector limit.
COLLECTOR_RATE_PER_MINUTE=120

# Per-site ceiling. Backstop for distributed sources with genuinely different
# addresses, where per-visitor limiting cannot help.
COLLECTOR_RATE_PER_SITE_PER_MINUTE=6000
