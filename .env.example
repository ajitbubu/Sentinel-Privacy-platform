# ==================== Shared ====================
APP_ENV=development
LOG_LEVEL=INFO

# ==================== Database ====================
DATABASE_URL=postgresql://admin:password@localhost:5432/consent_db
MONGO_URL=mongodb://admin:password@localhost:27017/consent_db
REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_HOSTS=http://localhost:9200

# ==================== Security ====================
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=change-me-32-byte-key-for-aes256

# ==================== PMP Portal ====================
PMP_API_PORT=8001
PMP_FRONTEND_URL=http://localhost:3001

# ==================== IDP Console ====================
IDP_API_PORT=8002
IDP_FRONTEND_URL=http://localhost:3002

# ==================== External API ====================
EXTERNAL_API_PORT=8003

# ==================== Integrations ====================
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
HUBSPOT_API_KEY=
OUTREACH_CLIENT_ID=
OUTREACH_CLIENT_SECRET=
HIGHSPOT_API_KEY=

# ==================== Notifications ====================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
