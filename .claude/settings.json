{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(pnpm install)",
      "Bash(pnpm dev*)",
      "Bash(pnpm typecheck*)",
      "Bash(make help)",
      "Bash(make health)",
      "Bash(make up)",
      "Bash(make web)",
      "Bash(make logs)",
      "Bash(make test)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs*)",
      "Bash(curl http://localhost:*)",
      "Bash(python3 -m pytest*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-bash.sh"
          }
        ]
      }
    ]
  }
}
